{
  "name": "agentic-sheets",
  "version": "0.1.0",
  "description": "Google Sheets values API wrapper for JSON rows with a TypeScript SDK, CLI, MCP server, dry-run previews, and an in-memory adapter.",
  "keywords": [
    "Google Sheets",
    "google-sheets-api",
    "json",
    "spreadsheet",
    "rows",
    "TypeScript",
    "Node.js",
    "cli",
    "mcp",
    "oauth",
    "dry-run",
    "in-memory",
    "Zod"
  ],
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "https://github.com/pooriaarab/agentic-sheets.git"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.pooriaarab/agentic-sheets",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "agentic-sheets": "./dist/cli.js",
    "agentic-sheets-mcp": "./dist/mcp-bin.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "agentic-core": "0.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
